    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Notifica a un agente humano por Telegram cuando el cliente necesita atención personalizada: una queja seria, una duda que no puedas responder con certeza, o una petición explícita de hablar con una persona. Pásale un resumen claro de la conversación y la pregunta del cliente.",
        "chatId": "REPLACE_WITH_HUMAN_AGENT_CHAT_ID",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('mensaje', `Resumen claro de la conversación con el cliente que necesita atención humana: quién es, cuál es su pregunta o problema, y por qué se escala.`, 'string') }}",
        "additionalFields": {}
      },
