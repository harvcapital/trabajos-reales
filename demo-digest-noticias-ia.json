{
  "name": "Demo - Digest Diario de Noticias con IA",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "d3000001-0000-4000-8000-000000000001",
      "name": "Programación Diaria",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -800,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://feeds.bbci.co.uk/mundo/rss.xml",
        "options": {}
      },
      "id": "d3000001-0000-4000-8000-000000000002",
      "name": "Leer Noticias",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        -560,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 8
      },
      "id": "d3000001-0000-4000-8000-000000000003",
      "name": "Limitar a las 8 más recientes",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst noticias = items.map((item, i) => {\n  const resumen = (item.json.contentSnippet || item.json.content || '').toString().slice(0, 200);\n  return `${i + 1}. ${item.json.title}\\n${item.json.link}\\n${resumen}`;\n}).join('\\n\\n');\nreturn [{ json: { noticias_texto: noticias } }];"
      },
      "id": "d3000001-0000-4000-8000-000000000004",
      "name": "Preparar Texto para IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.noticias_texto }}",
        "options": {
          "systemMessage": "Eres un curador de noticias. Recibes una lista numerada de titulares con su enlace y un fragmento de contenido. Elige las 4-5 noticias más relevantes o interesantes y redacta un resumen diario en español, ameno y directo, en formato de lista. Cada elemento debe llevar: un emoji relacionado con el tema, el titular resumido en una frase clara, y el enlace original. Cierra con una frase breve y motivadora para empezar el día. No inventes información que no esté en el texto recibido."
        }
      },
      "id": "d3000001-0000-4000-8000-000000000005",
      "name": "Agente Resumen de Noticias",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {}
      },
      "id": "d3000001-0000-4000-8000-000000000006",
      "name": "Modelo GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        80,
        224
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "d3000001-0000-4000-8000-000000000007",
      "name": "Enviar Digest por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        400,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Mi Bot de Telegram"
        }
      }
    }
  ],
  "pinData": {},
